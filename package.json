{
  "name": "Decantre",
  "private": true,
  "version": "2.0.08",
  "type": "module",
  "scripts": {
    "set-env": "node scripts/set-env.js",
    "prebuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('src/config.theme.client.json')) fs.writeFileSync('src/config.theme.client.json', '{}');\"",
    "dev": "node scripts/set-env.js dev && npm run prebuild && vite --host 0.0.0.0 --port 3000",
    "live": "node scripts/set-env.js live && npm run prebuild && vite --host 0.0.0.0 --port 3000",
    "dev:local": "node scripts/set-env.js local && npm run prebuild && vite --host 0.0.0.0 --port 3000",
    "build": "npm run prebuild && vite build",
    "build:dev": "node scripts/set-env.js dev && npm run prebuild && vite build",
    "build:live": "node scripts/set-env.js live && npm run prebuild && vite build",
    "prod": "serve -s dist -l 8001",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "echo 'No lint check needed'"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
